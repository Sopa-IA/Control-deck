# Copia a .env (ignorado por git) o usa scripts/gen-token.sh. NO pongas aquí valores reales.
ORBIT_HP_TOKEN=
ORBIT_UI_TOKEN=
# Nano de mandos con CH340. En Linux sale como ttyUSB, no ttyACM.
# Si también está el ESP8266, el número puede no ser 0: mirar /dev/serial/by-id.
ORBIT_SERIAL=/dev/ttyUSB0
# Segundos de espera tras abrir el puerto (el Nano se reinicia). No medido en el clon.
ORBIT_SERIAL_RESET_WAIT=2
ORBIT_HOST=127.0.0.1
ORBIT_PORT=8765

# Cambio de sistema visible (docs/conmutacion-video-usb.md). Todo opcional; vacío = modo remoto sin visor.
# Modo A (remoto): orden del visor, sin shell. Ejemplo: moonlight stream 10.42.0.2 Desktop
ORBIT_REMOTE_CMD=
# Modo C (capturadora HDMI->USB): dispositivo V4L2 y visor; {device} se sustituye.
# Ejemplo (sin verificar en la Pi de Miguel): mpv --profile=low-latency --untimed --fs av://v4l2:{device}
ORBIT_CAPTURE_DEVICE=
ORBIT_CAPTURE_CMD=
